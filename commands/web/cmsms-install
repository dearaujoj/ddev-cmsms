#!/usr/bin/env bash
#ddev-generated
## Description: Unattended CMSMS installer pipeline (stages: all fetch files db link)
## Usage: cmsms-install [stage]
## Example: ddev cmsms-install all
set -eu -o pipefail

PROJECT_ROOT=/var/www/html
DOCROOT=$PROJECT_ROOT/.cmsms/public
INSTALLER_DIR=$PROJECT_ROOT/.cmsms/installer
PAYLOAD_DIR=/mnt/ddev_config/cmsms
CACHE_DIR=$PAYLOAD_DIR/cache

CMSMS_VERSION="${CMSMS_VERSION:-$(jq -r '.default' $PAYLOAD_DIR/versions.json)}"
VCACHE=$CACHE_DIR/cmsms-$CMSMS_VERSION

log()  { echo "[cmsms-install] $*"; }
die()  { echo "[cmsms-install] ERROR: $*" >&2; exit 1; }

is_installed() {
  [ -f "$DOCROOT/config.php" ] || return 1
  mysql -h db -u db -pdb db -N -e 'SELECT version FROM cms_version' >/dev/null 2>&1
}

resolve_url() {
  if [ -n "${CMSMS_INSTALLER_URL:-}" ]; then
    echo "$CMSMS_INSTALLER_URL"
    return
  fi
  local url
  url=$(jq -r --arg v "$CMSMS_VERSION" '.versions[$v].url // empty' "$PAYLOAD_DIR/versions.json")
  [ -n "$url" ] || die "version $CMSMS_VERSION not in versions.json (available: $(jq -r '.versions|keys|join(", ")' "$PAYLOAD_DIR/versions.json")). Set CMSMS_INSTALLER_URL to a direct cmsms-X.Y.Z-install.zip URL to override."
  echo "$url"
}

stage_fetch() {
  if [ -s "$VCACHE/installer.php" ]; then
    log "fetch: installer for $CMSMS_VERSION already cached"
    return 0
  fi
  local url zip
  url=$(resolve_url)
  mkdir -p "$VCACHE"
  zip=$VCACHE/install.zip
  log "fetch: downloading $url"
  curl -fSL -o "$zip" "$url" \
    || die "download failed from $url — set CMSMS_INSTALLER_URL to a working mirror or local file"
  log "fetch: unpacking installer"
  unzip -oq "$zip" -d "$VCACHE"
  local phar
  phar=$(ls "$VCACHE"/cmsms-*-install.php 2>/dev/null | head -1)
  [ -n "$phar" ] || die "no cmsms-*-install.php found inside $zip"
  mv "$phar" "$VCACHE/installer.php"
  rm -f "$zip"
  log "fetch: cached at $VCACHE/installer.php"
}

stage_files() {
  [ -s "$VCACHE/installer.php" ] || stage_fetch
  local marker="$INSTALLER_DIR/.extract-complete"
  if [ -f "$marker" ]; then
    log "files: core already extracted"
  else
    rm -rf "$INSTALLER_DIR"
    php "$PAYLOAD_DIR/extract.php" "$VCACHE/installer.php" "$INSTALLER_DIR" "$DOCROOT" \
      || die "extraction failed"
  fi
  if [ ! -f "$DOCROOT/config.php" ]; then
    log "files: writing config.php"
    local tmp
    tmp=$(mktemp "$DOCROOT/config.php.XXXXXX")
    cat > "$tmp" <<EOF
<?php
# ddev-cmsms generated configuration
\$config['dbms'] = 'mysqli';
\$config['db_hostname'] = 'db';
\$config['db_username'] = 'db';
\$config['db_password'] = 'db';
\$config['db_name'] = 'db';
\$config['db_prefix'] = 'cms_';
\$config['timezone'] = '${TZ:-UTC}';
EOF
    mv "$tmp" "$DOCROOT/config.php"
  fi
  mkdir -p "$DOCROOT/tmp/cache" "$DOCROOT/tmp/templates_c" "$DOCROOT/uploads"
}
stage_db() {
  [ -f "$DOCROOT/lib/include.php" ] || stage_files
  if is_installed; then
    log "db: already installed"
    return 0
  fi
  log "db: running headless installer"
  php "$PAYLOAD_DIR/install.php" "$DOCROOT" "$INSTALLER_DIR/app" "${DDEV_SITENAME:-CMSMS Dev Site}" \
    || die "database install failed — fix the error above and re-run 'ddev exec cmsms-install db' (safe to re-run)"
}
# Per-entry relative symlinks from $2 (real dir) up $3 levels to project root,
# skipping the exclusion list. Avoids the modules/<Name> -> repo-root cycle.
link_entries() {
  local dest=$1 updots=$2 entry base skip
  local exclude="${CMSMS_LINK_EXCLUDE:-.ddev .cmsms .git .gitignore dist docs}"
  mkdir -p "$dest"
  for entry in "$PROJECT_ROOT"/* "$PROJECT_ROOT"/.[!.]*; do
    [ -e "$entry" ] || continue
    base=$(basename "$entry")
    skip=0
    for x in $exclude; do [ "$base" = "$x" ] && skip=1 && break; done
    [ "$skip" = 1 ] && continue
    ln -sfn "$updots/$base" "$dest/$base"
  done
}

stage_link() {
  is_installed || die "link: site not installed yet (run 'cmsms-install db' first)"
  [ -n "${CMSMS_EXT_TYPE:-}" ] || die "link: CMSMS_EXT_TYPE not set — run 'ddev cmsms setup'"
  [ -n "${CMSMS_EXT_NAME:-}" ] || die "link: CMSMS_EXT_NAME not set — run 'ddev cmsms setup'"

  case "$CMSMS_EXT_TYPE" in
    module)
      log "link: linking module $CMSMS_EXT_NAME"
      # modules/<Name>/<entry> -> ../../../../<entry>  (modules/Name -> public -> .cmsms -> html)
      link_entries "$DOCROOT/modules/$CMSMS_EXT_NAME" "../../../.."
      php "$PAYLOAD_DIR/register-extension.php" "$DOCROOT" module "$CMSMS_EXT_NAME" || die "module registration failed"
      ;;
    plugin)
      log "link: linking plugin file(s)"
      local found=0
      for f in "$PROJECT_ROOT"/function.*.php "$PROJECT_ROOT"/modifier.*.php; do
        [ -e "$f" ] || continue
        found=1
        # plugins/<file> -> ../../../<file>  (plugins -> public -> .cmsms -> html)
        ln -sfn "../../../$(basename "$f")" "$DOCROOT/plugins/$(basename "$f")"
      done
      [ "$found" = 1 ] || die "no function.*.php / modifier.*.php found at project root"
      ;;
    theme)
      log "link: linking admin theme $CMSMS_EXT_NAME"
      if [ -f "$PROJECT_ROOT/$CMSMS_EXT_NAME/${CMSMS_EXT_NAME}Theme.php" ]; then
        # theme lives in a subdirectory: safe to link the whole dir.
        # Link sits IN admin/themes/, so 4 levels up: themes -> admin -> public -> .cmsms = html
        ln -sfn "../../../../$CMSMS_EXT_NAME" "$DOCROOT/admin/themes/$CMSMS_EXT_NAME"
      elif [ -f "$PROJECT_ROOT/${CMSMS_EXT_NAME}Theme.php" ]; then
        # theme files at repo root: per-entry links to avoid the cycle
        link_entries "$DOCROOT/admin/themes/$CMSMS_EXT_NAME" "../../../../.."
      else
        die "could not find ${CMSMS_EXT_NAME}Theme.php at repo root or in $CMSMS_EXT_NAME/"
      fi
      php "$PAYLOAD_DIR/register-extension.php" "$DOCROOT" theme "$CMSMS_EXT_NAME" || die "theme registration failed"
      ;;
    *)
      die "unknown CMSMS_EXT_TYPE '$CMSMS_EXT_TYPE' (expected module|theme|plugin)"
      ;;
  esac
  log "link: done"
}

core_version() {
  local f="$DOCROOT/lib/version.php" v=""
  if [ -f "$f" ]; then
    v=$(php -r 'include "'"$f"'"; echo $CMS_VERSION ?? "";' 2>/dev/null || true)
  fi
  if [ -n "$v" ]; then
    echo "$v"
  else
    mysql -h db -u db -pdb db -N -e 'SELECT version FROM cms_version' 2>/dev/null || echo "unknown"
  fi
}

stage_all() {
  if is_installed; then
    if [ -n "${CMSMS_EXT_TYPE:-}" ]; then
      log "already installed (CMSMS $(core_version)) — refreshing links"
      # Contained in a subshell: stage_link's die() calls `exit`, which would
      # otherwise take down this whole script (and the ddev-start post-hook
      # with it). A link-refresh failure on an already-installed site is not
      # fatal — warn and move on so `ddev start` stays safe.
      ( stage_link ) || log "warning: link refresh failed (see above) — fix and re-run 'ddev cmsms-install link'"
      return 0
    fi
    log "already installed (CMSMS $(core_version)) — nothing to do"
    return 0
  fi
  if [ -z "${CMSMS_EXT_TYPE:-}" ]; then
    log "no CMSMS_EXT_TYPE set — run 'ddev cmsms setup' first, then 'ddev restart'"
    return 0
  fi
  stage_fetch
  stage_files
  stage_db
  stage_link
  log "install complete: ${DDEV_PRIMARY_URL:-site} (${CMSMS_ADMIN_USER:-admin}/${CMSMS_ADMIN_PASSWORD:-admin} at ${DDEV_PRIMARY_URL:-}/admin, CMSMS $(core_version))"
}

case "${1:-all}" in
  all)   stage_all ;;
  fetch) stage_fetch ;;
  files) stage_files ;;
  db)    stage_db ;;
  link)  stage_link ;;
  *) die "unknown stage '$1' (stages: all fetch files db link)" ;;
esac
