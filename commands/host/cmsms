#!/usr/bin/env bash
#ddev-generated
## Description: CMSMS dev helpers (setup, admin, reinstall, package, status)
## Usage: cmsms [setup|admin|reinstall|package|status]
## Example: ddev cmsms setup
set -eu -o pipefail

PROJECT_CONFIG=.ddev/config.cmsms-project.yaml

detect_type() {
  if ls ./*.module.php >/dev/null 2>&1; then echo module
  elif ls ./function.*.php >/dev/null 2>&1; then echo plugin
  elif ls ./*Theme.php ./*/*Theme.php >/dev/null 2>&1; then echo theme
  else echo module; fi
}

detect_name() {
  local t=$1 f
  case "$t" in
    module) f=$(ls ./*.module.php 2>/dev/null | head -1) && basename "$f" .module.php ;;
    plugin) f=$(ls ./function.*.php 2>/dev/null | head -1) && basename "$f" .php | sed 's/^function\.//' ;;
    theme)  f=$(ls ./*Theme.php ./*/*Theme.php 2>/dev/null | head -1) && basename "$f" Theme.php ;;
  esac
}

default_version() {
  jq -r '.default' .ddev/cmsms/versions.json 2>/dev/null || echo 2.2.22
}

cmd_setup() {
  local type="" name="" version="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --type) type=$2; shift 2 ;;
      --name) name=$2; shift 2 ;;
      --version) version=$2; shift 2 ;;
      --yes|-y) yes=1; shift ;;
      *) echo "unknown option $1" >&2; exit 2 ;;
    esac
  done

  local dtype dname dversion
  dtype=$(detect_type); dname=$(detect_name "$dtype" || true); dversion=$(default_version)

  if [ "$yes" != 1 ]; then
    read -r -p "Extension type [module/theme/plugin] (detected: $dtype): " type_in
    type=${type:-${type_in:-$dtype}}
    read -r -p "Extension name (detected: ${dname:-none}): " name_in
    name=${name:-${name_in:-$dname}}
    read -r -p "CMSMS version (default: $dversion): " version_in
    version=${version:-${version_in:-$dversion}}
  else
    type=${type:-$dtype}; name=${name:-$dname}; version=${version:-$dversion}
  fi

  case "$type" in module|theme|plugin) ;; *) echo "invalid type '$type'" >&2; exit 2 ;; esac
  [ -n "$name" ] || { echo "could not determine extension name — pass --name" >&2; exit 2; }

  # non-blocking sanity warning
  case "$type" in
    module) [ -f "./$name.module.php" ] || echo "warning: ./$name.module.php not found (yet?)" ;;
    plugin) ls ./function.*.php >/dev/null 2>&1 || echo "warning: no function.*.php found (yet?)" ;;
    theme)  [ -f "./${name}Theme.php" ] || [ -f "./$name/${name}Theme.php" ] || echo "warning: ${name}Theme.php not found (yet?)" ;;
  esac

  cat > "$PROJECT_CONFIG" <<EOF
# Generated by 'ddev cmsms setup'. Edit freely, then 'ddev restart'.
web_environment:
  - CMSMS_EXT_TYPE=$type
  - CMSMS_EXT_NAME=$name
  - CMSMS_VERSION=$version
EOF
  echo "wrote $PROJECT_CONFIG (type=$type name=$name version=$version)"
  echo "next: ddev start   (or 'ddev restart' if already running)"
}

cmd_admin() {
  echo "admin credentials: admin / admin"
  ddev launch /admin
}

cmd_status() {
  local core ext_type ext_name want_version link_ok mod_ok
  core=$(ddev mysql -N -e 'SELECT version FROM cms_version' 2>/dev/null || echo "not installed")
  ext_type=$(ddev exec 'printf "%s" "${CMSMS_EXT_TYPE:-}"' 2>/dev/null || true)
  ext_name=$(ddev exec 'printf "%s" "${CMSMS_EXT_NAME:-}"' 2>/dev/null || true)
  want_version=$(ddev exec 'printf "%s" "${CMSMS_VERSION:-}"' 2>/dev/null || true)
  echo "CMSMS core:      $core (configured: ${want_version:-default})"
  echo "Extension:       ${ext_type:-unset} / ${ext_name:-unset}"
  if [ -n "$ext_name" ] && [ "$ext_type" = "module" ]; then
    if ddev exec test -e "/var/www/html/.cmsms/public/modules/$ext_name" >/dev/null 2>&1; then link_ok=linked; else link_ok="NOT linked"; fi
    mod_ok=$(ddev mysql -N -e "SELECT COUNT(*) FROM cms_modules WHERE module_name='$ext_name'" 2>/dev/null || echo 0)
    [ "$mod_ok" = "1" ] && mod_ok=installed || mod_ok="NOT installed"
    echo "Module link:     $link_ok"
    echo "Module in DB:    $mod_ok"
  fi
  echo "URLs:            $(ddev describe -j 2>/dev/null | jq -r '.raw.primary_url // empty') (admin: /admin, admin/admin)"
}

cmd_reinstall() { echo "reinstall: implemented in a later task"; exit 1; }
cmd_package()   { echo "package: implemented in a later task"; exit 1; }

case "${1:-}" in
  setup)     shift; cmd_setup "$@" ;;
  admin)     cmd_admin ;;
  status)    cmd_status ;;
  reinstall) shift || true; cmd_reinstall "$@" ;;
  package)   cmd_package ;;
  *) echo "usage: ddev cmsms [setup|admin|reinstall|package|status]"; exit 2 ;;
esac
