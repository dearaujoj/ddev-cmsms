#!/usr/bin/env bash
#ddev-generated
## Description: CMSMS dev helpers (setup, load, add, admin, reinstall, package, status)
## Usage: cmsms [setup|scaffold|load|add|admin|reinstall|package|status]
## Example: ddev cmsms setup
set -eu -o pipefail

PROJECT_CONFIG=.ddev/config.cmsms-project.yaml

detect_type() {
  if ls ./*.module.php >/dev/null 2>&1; then echo module
  elif ls ./function.*.php >/dev/null 2>&1; then echo plugin
  elif ls ./*Theme.php ./*/*Theme.php >/dev/null 2>&1; then echo theme
  else echo module; fi
}

detect_name() {
  local t=$1 f
  case "$t" in
    module) f=$(ls ./*.module.php 2>/dev/null | head -1) && basename "$f" .module.php ;;
    plugin) f=$(ls ./function.*.php 2>/dev/null | head -1) && basename "$f" .php | sed 's/^function\.//' ;;
    theme)  f=$(ls ./*Theme.php ./*/*Theme.php 2>/dev/null | head -1) && basename "$f" Theme.php ;;
  esac
}

default_version() {
  jq -r '.default' .ddev/cmsms/versions.json 2>/dev/null || echo 2.2.22
}

# Validate a space-separated CMSMS_EXTENSIONS list: type:Name entries.
validate_entries() {
  local entry
  for entry in $1; do
    if ! [[ "$entry" =~ ^(module|plugin|theme):[A-Za-z0-9_]+$ ]]; then
      echo "invalid extension entry '$entry' — expected type:Name with type module|plugin|theme and Name matching ^[A-Za-z0-9_]+\$" >&2
      return 1
    fi
  done
  return 0
}

# Scan immediate subdirectories for extensions (workspace detection).
# Output: space-separated type:Name list in directory (alpha) order — the
# user reorders for dependencies; setup prints a reminder.
detect_workspace_entries() {
  local d name out=""
  for d in ./*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    case "$name" in .*|dist|docs|node_modules|vendor) continue ;; esac
    [[ "$name" =~ ^[A-Za-z0-9_]+$ ]] || continue
    if [ -f "$d$name.module.php" ]; then out="$out module:$name"
    elif [ -f "$d${name}Theme.php" ]; then out="$out theme:$name"
    elif ls "$d"function.*.php >/dev/null 2>&1; then out="$out plugin:$name"
    fi
  done
  echo "${out# }"
}

# Copy a skeleton dir to dest, substituting __NAME__/__name__ in paths and
# contents, and stripping every line that contains the #ddev-generated marker
# (templates carry it so add-on upgrades refresh them; generated user code
# must ship clean).
#
# Two passes: first compute every destination path and refuse (listing what's
# in the way) if ANY of them already exists, then write. A single filename
# check in the caller (e.g. ./$name.module.php) isn't enough — other skeleton
# files like action.default.php or templates/default.tpl don't embed the
# module name, so scaffolding a second module/plugin into the same dir would
# otherwise silently clobber the first one's non-name-bearing files.
scaffold_from_skeleton() {
  local src=$1 dest=$2 name=$3 lname rel out
  [ -d "$src" ] || { echo "skeleton dir $src missing — re-run 'ddev add-on get'" >&2; exit 2; }
  lname=$(echo "$name" | tr '[:upper:]' '[:lower:]')

  local rels=() outs=() existing=()
  while IFS= read -r rel; do
    rel=${rel#./}
    rels+=("$rel")
    out=$dest/$(echo "$rel" | sed -e "s/__NAME__/$name/g" -e "s/__name__/$lname/g")
    outs+=("$out")
    [ -e "$out" ] && existing+=("$out")
  done < <( cd "$src" && find . -type f )

  if [ "${#existing[@]}" -gt 0 ]; then
    echo "refusing to overwrite existing file(s):" >&2
    printf '  %s\n' "${existing[@]}" >&2
    exit 2
  fi

  local i
  for i in "${!rels[@]}"; do
    rel=${rels[$i]}
    out=${outs[$i]}
    mkdir -p "$(dirname "$out")"
    # `grep -v` alone would exit 1 (aborting under pipefail) if a skeleton
    # file consists solely of marker lines; `|| true` makes "empty output
    # file" the correct, non-fatal result of that case.
    sed -e "s/__NAME__/$name/g" -e "s/__name__/$lname/g" "$src/$rel" | { grep -v '#ddev-generated' || true; } > "$out"
  done
}

cmd_scaffold() {
  local type="" name="" dir="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --type)
        case "${2:-}" in ''|--*) echo "missing value for --type" >&2; exit 2 ;; esac
        type=$2; shift 2 ;;
      --name)
        case "${2:-}" in ''|--*) echo "missing value for --name" >&2; exit 2 ;; esac
        name=$2; shift 2 ;;
      --dir)
        case "${2:-}" in ''|--*) echo "missing value for --dir" >&2; exit 2 ;; esac
        dir=$2; shift 2 ;;
      --yes|-y) yes=1; shift ;;
      *) echo "unknown option $1" >&2; exit 2 ;;
    esac
  done

  local dtype dname
  dtype=$(detect_type); dname=$(detect_name "$dtype" || true)
  if [ "$yes" != 1 ]; then
    if [ -z "$type" ]; then
      read -r -p "Extension type to scaffold [module/plugin/theme] (default: $dtype): " t_in
      type=${t_in:-$dtype}
    fi
    if [ -z "$name" ]; then
      read -r -p "Name for the new $type: " n_in
      name=${n_in:-$dname}
    fi
  else
    type=${type:-$dtype}; name=${name:-$dname}
  fi

  case "$type" in module|plugin|theme) ;; *) echo "invalid type '$type'" >&2; exit 2 ;; esac
  [ -n "$name" ] || { echo "scaffold needs a name — pass --name" >&2; exit 2; }
  if ! [[ "$name" =~ ^[A-Za-z0-9_]+$ ]]; then
    echo "invalid name '$name': must match ^[A-Za-z0-9_]+\$" >&2
    exit 2
  fi
  local lname
  lname=$(echo "$name" | tr '[:upper:]' '[:lower:]')

  local dest="."
  if [ -n "$dir" ]; then
    if ! [[ "$dir" =~ ^[A-Za-z0-9_]+$ ]]; then
      echo "invalid --dir '$dir': must match ^[A-Za-z0-9_]+\$" >&2
      exit 2
    fi
    dest="./$dir"
  fi

  case "$type" in
    module)
      [ -e "$dest/$name.module.php" ] && { echo "$dest/$name.module.php already exists — refusing to overwrite" >&2; exit 2; }
      mkdir -p "$dest"
      scaffold_from_skeleton .ddev/cmsms/skeletons/module "$dest" "$name"
      echo "scaffolded module $name — edit $dest/$name.module.php, then 'ddev start' to install it"
      ;;
    plugin)
      [ -e "$dest/function.$lname.php" ] && { echo "$dest/function.$lname.php already exists — refusing to overwrite" >&2; exit 2; }
      mkdir -p "$dest"
      scaffold_from_skeleton .ddev/cmsms/skeletons/plugin "$dest" "$name"
      echo "scaffolded plugin function.$lname.php — 'ddev start' links it into the site"
      ;;
    theme)
      if [ -n "$dir" ] && [ "$dir" != "$name" ]; then
        echo "theme scaffold requires --dir to equal the theme name ($name) — the directory name IS the theme name" >&2
        exit 2
      fi
      [ -e "./$name" ] && { echo "./$name already exists — refusing to overwrite" >&2; exit 2; }
      local theme_src=.cmsms/public/admin/themes/OneEleven
      if [ ! -d "$theme_src" ]; then
        echo "core not installed yet — run 'ddev start' first, then re-run 'ddev cmsms scaffold'" >&2
        exit 2
      fi
      # The CMSMS-idiomatic starter admin theme is a renamed copy of OneEleven.
      cp -R "$theme_src" "./$name"
      mv "./$name/OneElevenTheme.php" "./$name/${name}Theme.php"
      # rename the class (and any self-references) inside the theme class file;
      # sed -i needs a suffix arg on macOS/BSD
      sed -i.bak "s/OneEleven/$name/g" "./$name/${name}Theme.php" && rm -f "./$name/${name}Theme.php.bak"
      echo "scaffolded admin theme $name/ — link it with 'ddev cmsms-install link' (or next 'ddev start')"
      ;;
  esac
}

cmd_setup() {
  local type="" name="" version="" extensions="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --type)
        case "${2:-}" in ''|--*) echo "missing value for --type" >&2; exit 2 ;; esac
        type=$2; shift 2 ;;
      --name)
        case "${2:-}" in ''|--*) echo "missing value for --name" >&2; exit 2 ;; esac
        name=$2; shift 2 ;;
      --version)
        case "${2:-}" in ''|--*) echo "missing value for --version" >&2; exit 2 ;; esac
        version=$2; shift 2 ;;
      --extensions)
        case "${2:-}" in ''|--*) echo "missing value for --extensions" >&2; exit 2 ;; esac
        extensions=$2; shift 2 ;;
      --yes|-y) yes=1; shift ;;
      *) echo "unknown option $1" >&2; exit 2 ;;
    esac
  done

  if [ -n "$extensions" ] && { [ -n "$type" ] || [ -n "$name" ]; }; then
    echo "--extensions is mutually exclusive with --type/--name" >&2
    exit 2
  fi

  # workspace auto-detection: nothing explicit given, no root-level extension
  # files, but extension-looking subdirectories exist
  if [ -z "$extensions" ] && [ -z "$type" ] && [ -z "$name" ] \
     && ! ls ./*.module.php ./function.*.php ./*Theme.php >/dev/null 2>&1; then
    local dws
    dws=$(detect_workspace_entries)
    if [ -n "$dws" ]; then
      if [ "$yes" = 1 ]; then
        extensions=$dws
      else
        echo "Detected workspace extensions (order = install order — list dependencies first):"
        echo "  $dws"
        read -r -p "Use these? [Y/n or type a corrected list] " ws_in || ws_in=""
        case "$ws_in" in
          n|N|no) ;;
          ""|y|Y|yes) extensions=$dws ;;
          *) extensions=$ws_in ;;
        esac
      fi
    fi
  fi

  if [ -n "$extensions" ]; then
    validate_entries "$extensions" || exit 2
    local dversion
    dversion=$(default_version)
    if [ "$yes" != 1 ] && [ -z "$version" ]; then
      read -r -p "CMSMS version (default: $dversion): " version_in || version_in=""
      version=${version_in:-$dversion}
    fi
    version=${version:-$dversion}
    if ! [[ "$version" =~ ^[0-9][0-9.]*([.-][A-Za-z0-9.]+)?$ ]]; then
      echo "invalid version '$version': must match ^[0-9][0-9.]*([.-][A-Za-z0-9.]+)?\$" >&2
      exit 2
    fi
    cat > "$PROJECT_CONFIG" <<EOF
# Generated by 'ddev cmsms setup' (workspace mode). Edit freely, then 'ddev restart'.
# Order of CMSMS_EXTENSIONS = install order: list dependencies before dependents.
web_environment:
  - CMSMS_EXTENSIONS=$extensions
  - CMSMS_VERSION=$version
EOF
    echo "wrote $PROJECT_CONFIG (workspace: $extensions, version=$version)"
    echo "next: ddev start   (or 'ddev restart' if already running)"
    return 0
  fi

  local dtype dname dversion
  dtype=$(detect_type); dname=$(detect_name "$dtype" || true); dversion=$(default_version)

  if [ "$yes" != 1 ]; then
    if [ -z "$type" ]; then
      read -r -p "Extension type [module/theme/plugin] (detected: $dtype): " type_in
      type=${type_in:-$dtype}
    fi
    if [ -z "$name" ]; then
      read -r -p "Extension name (detected: ${dname:-none}): " name_in
      name=${name_in:-$dname}
    fi
    if [ -z "$version" ]; then
      read -r -p "CMSMS version (default: $dversion): " version_in
      version=${version_in:-$dversion}
    fi
  else
    type=${type:-$dtype}; name=${name:-$dname}; version=${version:-$dversion}
  fi

  case "$type" in module|theme|plugin) ;; *) echo "invalid type '$type'" >&2; exit 2 ;; esac
  [ -n "$name" ] || { echo "could not determine extension name — pass --name" >&2; exit 2; }

  # name must be CMSMS module/class-name-safe: this value is written into the
  # generated YAML and later interpolated into a SQL literal by cmd_status, so
  # keeping it restricted to [A-Za-z0-9_] is what makes that interpolation safe.
  if ! [[ "$name" =~ ^[A-Za-z0-9_]+$ ]]; then
    echo "invalid name '$name': must match ^[A-Za-z0-9_]+\$" >&2
    exit 2
  fi
  if ! [[ "$version" =~ ^[0-9][0-9.]*([.-][A-Za-z0-9.]+)?$ ]]; then
    echo "invalid version '$version': must match ^[0-9][0-9.]*([.-][A-Za-z0-9.]+)?\$" >&2
    exit 2
  fi

  # sanity check — offer to scaffold a starter when nothing matches
  local missing=0
  case "$type" in
    module) [ -f "./$name.module.php" ] || missing=1 ;;
    plugin) ls ./function.*.php >/dev/null 2>&1 || missing=1 ;;
    theme)  [ -f "./${name}Theme.php" ] || [ -f "./$name/${name}Theme.php" ] || missing=1 ;;
  esac
  if [ "$missing" = 1 ]; then
    if [ "$type" = theme ] && [ ! -d .cmsms/public/admin/themes/OneEleven ]; then
      # theme scaffolding copies OneEleven from the installed core, which
      # doesn't exist before the first 'ddev start'
      echo "note: no ${name}Theme.php yet — after 'ddev start', run 'ddev cmsms scaffold' to copy a starter theme" >&2
    elif [ "$yes" = 1 ]; then
      # Contained in a subshell: cmd_scaffold's exit-2 refusals (e.g. an
      # existing target file) would otherwise abort cmd_setup before
      # $PROJECT_CONFIG is written. A scaffold refusal here is not fatal —
      # warn and let setup finish (mirrors stage_all's `( stage_link ) ||`
      # idiom in commands/web/cmsms-install).
      ( cmd_scaffold --type "$type" --name "$name" --yes ) || echo "warning: scaffold failed (see above) — continuing setup" >&2
    else
      read -r -p "No $type files found — create a starter $type named $name? [Y/n] " ans || ans=""
      case "$ans" in
        n|N|no) echo "warning: no $type files for '$name' found (yet?)" >&2 ;;
        *) ( cmd_scaffold --type "$type" --name "$name" --yes ) || echo "warning: scaffold failed (see above) — continuing setup" >&2 ;;
      esac
    fi
  fi

  cat > "$PROJECT_CONFIG" <<EOF
# Generated by 'ddev cmsms setup'. Edit freely, then 'ddev restart'.
web_environment:
  - CMSMS_EXT_TYPE=$type
  - CMSMS_EXT_NAME=$name
  - CMSMS_VERSION=$version
EOF
  echo "wrote $PROJECT_CONFIG (type=$type name=$name version=$version)"
  echo "next: ddev start   (or 'ddev restart' if already running)"
}

cmd_admin() {
  local user pass
  user=$(ddev exec 'printf "%s" "${CMSMS_ADMIN_USER:-admin}"' 2>/dev/null || echo admin)
  pass=$(ddev exec 'printf "%s" "${CMSMS_ADMIN_PASSWORD:-admin}"' 2>/dev/null || echo admin)
  echo "admin credentials: $user / $pass"
  ddev launch /admin
}

cmd_status() {
  local core ext_type ext_name want_version link_ok mod_ok admin_user admin_pass
  core=$(ddev exec 'f=/var/www/html/.cmsms/public/lib/version.php; v=$(php -r "include \"$f\"; echo \$CMS_VERSION ?? \"\";" 2>/dev/null); if [ -n "$v" ]; then echo "$v"; else mysql -h db -u db -pdb db -N -e "SELECT version FROM cms_version" 2>/dev/null || echo "not installed"; fi' 2>/dev/null || echo "not installed")
  ext_type=$(ddev exec 'printf "%s" "${CMSMS_EXT_TYPE:-}"' 2>/dev/null || true)
  ext_name=$(ddev exec 'printf "%s" "${CMSMS_EXT_NAME:-}"' 2>/dev/null || true)
  want_version=$(ddev exec 'printf "%s" "${CMSMS_VERSION:-}"' 2>/dev/null || true)
  admin_user=$(ddev exec 'printf "%s" "${CMSMS_ADMIN_USER:-admin}"' 2>/dev/null || echo admin)
  admin_pass=$(ddev exec 'printf "%s" "${CMSMS_ADMIN_PASSWORD:-admin}"' 2>/dev/null || echo admin)
  echo "CMSMS core:      $core (configured: ${want_version:-default})"
  echo "Extension:       ${ext_type:-unset} / ${ext_name:-unset}"
  local extensions
  extensions=$(ddev exec 'printf "%s" "${CMSMS_EXTENSIONS:-}"' 2>/dev/null || true)
  if [ -n "$extensions" ]; then
    echo "Workspace extensions (install order):"
    local entry etype ename lk rg
    for entry in $extensions; do
      etype=${entry%%:*}; ename=${entry#*:}
      if ! [[ "$ename" =~ ^[A-Za-z0-9_]+$ ]]; then
        echo "  $entry — invalid entry"
        continue
      fi
      case "$etype" in
        module)
          if ddev exec test -e "/var/www/html/.cmsms/public/modules/$ename" >/dev/null 2>&1; then lk=linked; else lk="NOT linked"; fi
          # safe interpolation: ename validated against [A-Za-z0-9_] above
          rg=$(ddev mysql -N -e "SELECT COUNT(*) FROM cms_modules WHERE module_name='$ename'" 2>/dev/null || echo 0)
          [ "$rg" = "1" ] && rg=registered || rg="NOT registered"
          echo "  module:$ename — $lk, $rg"
          ;;
        theme)
          if ddev exec test -e "/var/www/html/.cmsms/public/admin/themes/$ename" >/dev/null 2>&1; then lk=linked; else lk="NOT linked"; fi
          echo "  theme:$ename — $lk"
          ;;
        plugin)
          if ddev exec bash -c 'for f in /var/www/html/'"$ename"'/function.*.php /var/www/html/'"$ename"'/modifier.*.php; do [ -e "/var/www/html/.cmsms/public/plugins/$(basename "$f")" ] && exit 0; done; exit 1' >/dev/null 2>&1; then lk=linked; else lk="NOT linked"; fi
          echo "  plugin:$ename — $lk"
          ;;
      esac
    done
  elif [ -n "$ext_name" ] && [ "$ext_type" = "module" ]; then
    if ddev exec test -e "/var/www/html/.cmsms/public/modules/$ext_name" >/dev/null 2>&1; then link_ok=linked; else link_ok="NOT linked"; fi
    # $ext_name is interpolated unescaped into the SQL literal below. This is safe
    # because cmd_setup only ever writes names matching [A-Za-z0-9_] into the config
    # (see the validation there); re-check the invariant here as defense in depth in
    # case CMSMS_EXT_NAME was set by hand-editing config.cmsms-project.yaml instead.
    if [[ "$ext_name" =~ ^[A-Za-z0-9_]+$ ]]; then
      mod_ok=$(ddev mysql -N -e "SELECT COUNT(*) FROM cms_modules WHERE module_name='$ext_name'" 2>/dev/null || echo 0)
      [ "$mod_ok" = "1" ] && mod_ok=installed || mod_ok="NOT installed"
    else
      mod_ok="unknown (invalid CMSMS_EXT_NAME)"
    fi
    echo "Module link:     $link_ok"
    echo "Module in DB:    $mod_ok"
  fi
  echo "URLs:            $(ddev describe -j 2>/dev/null | jq -r '.raw.primary_url // empty') (admin: /admin, $admin_user/$admin_pass)"
}

cmd_reinstall() {
  local yes=0
  case "${1:-}" in --yes|-y) yes=1 ;; esac   # (an `[ ] || [ ] && x` chain would trip set -e)
  if [ "$yes" != 1 ]; then
    read -r -p "This DROPS the database and deletes .cmsms/ core files. Continue? [y/N] " ans
    case "$ans" in y|Y|yes) ;; *) echo "aborted"; exit 1 ;; esac
  fi
  echo "dropping database..."
  ddev mysql -uroot -proot -e "DROP DATABASE IF EXISTS db; CREATE DATABASE db;"
  echo "removing core files (keeping download cache)..."
  # config.cmsms.yaml declares upload_dirs: [uploads], so
  # .cmsms/public/uploads is bind-mounted directly (bypassing mutagen) rather
  # than living inside the synced project volume. `rm -rf .cmsms/public`
  # would recurse into that mount and then fail to rmdir the mountpoint
  # itself ("device or resource busy"). Empty it in place instead of
  # removing it, and leave public/ standing so extract.php's PharData
  # overwrite-extract has an existing tree to write back into.
  ddev exec '
    rm -rf /var/www/html/.cmsms/installer
    find /var/www/html/.cmsms/public -mindepth 1 -maxdepth 1 -not -name uploads -exec rm -rf {} +
    find /var/www/html/.cmsms/public/uploads -mindepth 1 -exec rm -rf {} +
  '
  echo "reinstalling..."
  ddev cmsms-install all
}

cmd_package() {
  local ext_type ext_name
  ext_type=$(ddev exec 'printf "%s" "${CMSMS_EXT_TYPE:-}"')
  ext_name=$(ddev exec 'printf "%s" "${CMSMS_EXT_NAME:-}"')
  [ "$ext_type" = "module" ] || { echo "package only works for module projects (this is: ${ext_type:-unset})" >&2; exit 2; }
  ddev exec php /mnt/ddev_config/cmsms/package.php /var/www/html/.cmsms/public "$ext_name" /var/www/html/dist
}

cmd_load() {
  local zip="" use=0 arg
  for arg in "$@"; do
    case "$arg" in
      --use) use=1 ;;
      -*) echo "unknown option $arg" >&2; exit 2 ;;
      *)
        if [ -n "$zip" ]; then
          echo "unexpected extra argument '$arg' (already got zip path '$zip')" >&2
          exit 2
        fi
        zip=$arg
        ;;
    esac
  done
  [ -n "$zip" ] || { echo "usage: ddev cmsms load <installer.zip> [--use]" >&2; exit 2; }
  [ -r "$zip" ] || { echo "installer zip not found (or unreadable): $zip" >&2; exit 2; }

  # host-portability guard: unzip ships with macOS/most Linux/WSL2, but not
  # every minimal environment (some git-bash installs)
  command -v unzip >/dev/null 2>&1 \
    || { echo "'unzip' is required by 'ddev cmsms load' — install it (e.g. apt/dnf install unzip) and retry" >&2; exit 2; }

  local listing
  listing=$(unzip -l "$zip" 2>/dev/null) \
    || { echo "not a readable zip archive: $zip" >&2; exit 2; }

  # The inner self-extracting phar is named cmsms-<version>-install.php by
  # the CMSMS build itself — that name is the version truth, never the outer
  # filename (users rename downloads).
  local inner count version
  inner=$(printf '%s\n' "$listing" | grep -oE '[^ /]*cmsms-[^ /]*-install\.php' | sort -u || true)
  count=$(printf '%s' "$inner" | grep -c . || true)
  if [ "$count" != 1 ]; then
    echo "expected exactly one cmsms-<version>-install.php inside $zip (found: ${count:-0})" >&2
    exit 2
  fi
  # Same match, but with the path separator allowed through, so a nested
  # entry (e.g. sub/cmsms-X-install.php) shows up as a "/"-bearing string —
  # stage_fetch expects the phar at the zip root and can't use a nested one.
  local inner_path
  inner_path=$(printf '%s\n' "$listing" | grep -oE '[^ ]*cmsms-[^ /]*-install\.php' | sort -u || true)
  if printf '%s\n' "$inner_path" | grep -q '/'; then
    echo "installer phar must be at the zip root (found nested: $inner_path)" >&2
    exit 2
  fi
  version=$(printf '%s' "$inner" | sed -E 's/^cmsms-(.+)-install\.php$/\1/')
  if ! [[ "$version" =~ ^[0-9][0-9.]*([.-][A-Za-z0-9.]+)?$ ]]; then
    echo "inner phar '$inner' has an unparseable version '$version'" >&2
    exit 2
  fi

  local dest=.ddev/cmsms/cache/cmsms-$version-install.zip
  mkdir -p .ddev/cmsms/cache
  [ -e "$dest" ] && echo "note: replacing existing $dest"
  cp "$zip" "$dest"
  # stage_fetch short-circuits when the expanded dir already exists, so a
  # same-version reload must clear it too — otherwise a rebuilt/corrected
  # core in the new zip never gets re-expanded and reinstall silently keeps
  # serving whatever was expanded from the old zip.
  rm -rf ".ddev/cmsms/cache/cmsms-$version"
  echo "loaded CMSMS $version into the cache ($dest)"

  if [ "$use" = 1 ]; then
    if [ ! -f "$PROJECT_CONFIG" ]; then
      echo "--use needs an existing $PROJECT_CONFIG — run 'ddev cmsms setup' first" >&2
      exit 2
    fi
    # sed -i needs a suffix arg on macOS/BSD. Checked explicitly (not `&&` in
    # a chain) because under `set -e` only the last command of an `&&` list
    # aborts the function — a failed sed followed by `&& rm -f ...bak` would
    # fall through to the success message below, a silent false success.
    if ! sed -i.bak "s/^  - CMSMS_VERSION=.*/  - CMSMS_VERSION=$version/" "$PROJECT_CONFIG"; then
      rm -f "$PROJECT_CONFIG.bak"
      echo "could not update $PROJECT_CONFIG — check permissions" >&2
      exit 2
    fi
    rm -f "$PROJECT_CONFIG.bak"
    # The sed pattern above is anchored to the exact "  - CMSMS_VERSION="
    # format cmd_setup writes. If the file was hand-edited (re-indented, etc)
    # sed matches nothing and exits 0 with the file unchanged — verify the
    # rewrite actually landed instead of trusting sed's exit code alone.
    grep -q "CMSMS_VERSION=$version" "$PROJECT_CONFIG" \
      || { echo "could not find a CMSMS_VERSION= line to update in $PROJECT_CONFIG — edit it manually" >&2; exit 2; }
    echo "set CMSMS_VERSION=$version in $PROJECT_CONFIG — run 'ddev restart', then 'ddev cmsms reinstall' to switch cores"
  else
    echo "use it with: ddev cmsms setup --version $version   (or re-run load with --use)"
  fi
}

cmd_add() {
  local etype="" ename="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      -*) echo "unknown option $1" >&2; exit 2 ;;
      *)
        if [ -z "$etype" ]; then etype=$1
        elif [ -z "$ename" ]; then ename=$1
        else echo "unexpected extra argument '$1'" >&2; exit 2; fi
        shift ;;
    esac
  done
  [ -n "$etype" ] && [ -n "$ename" ] || { echo "usage: ddev cmsms add <module|plugin|theme> <Name> [--yes]" >&2; exit 2; }
  validate_entries "$etype:$ename" || exit 2
  [ -f "$PROJECT_CONFIG" ] || { echo "no $PROJECT_CONFIG — run 'ddev cmsms setup' first" >&2; exit 2; }
  grep -q "CMSMS_EXTENSIONS=" "$PROJECT_CONFIG" \
    || { echo "$PROJECT_CONFIG is single-extension mode — re-run 'ddev cmsms setup' (workspace) to convert" >&2; exit 2; }

  if grep -Eq "CMSMS_EXTENSIONS=.*(=| )$etype:$ename( |\$)" "$PROJECT_CONFIG"; then
    echo "note: $etype:$ename already listed"
  else
    # same rewrite discipline as load --use: explicit failure check + post-grep
    if ! sed -i.bak "s|^  - CMSMS_EXTENSIONS=.*|& $etype:$ename|" "$PROJECT_CONFIG"; then
      rm -f "$PROJECT_CONFIG.bak"
      echo "could not update $PROJECT_CONFIG — check permissions" >&2
      exit 2
    fi
    rm -f "$PROJECT_CONFIG.bak"
    grep -Eq "CMSMS_EXTENSIONS=.*(=| )$etype:$ename( |\$)" "$PROJECT_CONFIG" \
      || { echo "could not find the CMSMS_EXTENSIONS line to update in $PROJECT_CONFIG — edit it manually" >&2; exit 2; }
    echo "added $etype:$ename to $PROJECT_CONFIG"
  fi

  if [ ! -d "./$ename" ]; then
    if [ "$yes" = 1 ]; then
      ( cmd_scaffold --type "$etype" --name "$ename" --dir "$ename" --yes ) \
        || echo "warning: scaffold failed (see above) — create ./$ename yourself" >&2
    else
      read -r -p "No ./$ename directory — scaffold a starter $etype there? [Y/n] " ans || ans=""
      case "$ans" in
        n|N|no) echo "note: create ./$ename before the next start" ;;
        *) ( cmd_scaffold --type "$etype" --name "$ename" --dir "$ename" --yes ) \
             || echo "warning: scaffold failed (see above) — create ./$ename yourself" >&2 ;;
      esac
    fi
  fi
  echo "next: ddev restart   (or 'ddev cmsms-install link' if already running)"
}

case "${1:-}" in
  setup)     shift; cmd_setup "$@" ;;
  scaffold)  shift; cmd_scaffold "$@" ;;
  load)      shift; cmd_load "$@" ;;
  add)       shift; cmd_add "$@" ;;
  admin)     cmd_admin ;;
  status)    cmd_status ;;
  reinstall) shift || true; cmd_reinstall "$@" ;;
  package)   cmd_package ;;
  *) echo "usage: ddev cmsms [setup|scaffold|load|add|admin|reinstall|package|status]"; exit 2 ;;
esac
